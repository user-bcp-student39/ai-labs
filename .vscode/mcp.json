{
  "servers": {
    "github-official": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "github-official-readonly": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "issues,repos,pull_requests",
        "X-MCP-Readonly": "true"
      }
    },
    "incidencias-lab": {
      "type": "http",
      "url": "https://bcp-ai-labs.pages.dev/api/lab-mcp",
      "headers": {
        "Authorization": "Bearer TOKEN"
      }
    }
  }
}